# ==========================================
# Civic Connect - Environment Configuration
# ==========================================

# Django Settings
DEBUG=True
SECRET_KEY=civic-connect-super-secret-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=civic_connect

# CORS Settings (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=True

# Security & Action Tokens
ACTION_TOKEN_SECRET=civic-connect-action-token-secret-salt-98765
ACTION_TOKEN_EXPIRY_DAYS=7

# Media Storage
MEDIA_ROOT=media
MEDIA_URL=/media/

# Cloudinary (Optional fallback for CDN storage)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Auth (Optional verification)
FIREBASE_CREDENTIALS_PATH=

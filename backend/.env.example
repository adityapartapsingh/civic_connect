# Civic Connect Environment Configuration

# Django
SECRET_KEY=civic-connect-super-secret-key-change-in-production-2026
DEBUG=False
ALLOWED_HOSTS=civic-connect-o1br.onrender.com,localhost,127.0.0.1

# Production URLs
FRONTEND_URL=https://civic-connect-psi.vercel.app
BACKEND_URL=https://civic-connect-o1br.onrender.com

# CORS & CSRF
CORS_ALLOWED_ORIGINS=https://civic-connect-psi.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://civic-connect-psi.vercel.app,https://civic-connect-o1br.onrender.com

# MongoDB Connection (Atlas production cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=civic_connect

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Action Token Configuration
ACTION_TOKEN_SECRET=civic-connect-action-token-secret-salt-98765
ACTION_TOKEN_EXPIRY_DAYS=7

# WhatsApp Gateway (Self-Hosted on Port 5005)
WHATSAPP_GATEWAY_URL=http://127.0.0.1:5005/send-otp

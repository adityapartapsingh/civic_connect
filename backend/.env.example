# Civic Connect Environment Configuration

# Django
SECRET_KEY=civic-connect-super-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=*

# MongoDB Connection (Leave empty to use in-memory mongomock for local dev/testing)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB_NAME=civic_connect

# Cloudinary Media Configuration
# Option 1: Full URL string
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Option 2: Individual keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Socket / Protocol Bridge
# Set to URL of self-hosted Baileys / whatsapp-web.js bridge
WHATSAPP_BRIDGE_URL=http://localhost:3001/send-message
WHATSAPP_ENABLED=False

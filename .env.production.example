# =================================================================
# CIVIC CONNECT - PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# 1. Django Backend Secrets
SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
DEBUG=False
ALLOWED_HOSTS=civicconnect.punjab.gov.in,your-domain.com,api.your-domain.com
CORS_ALLOWED_ORIGINS=https://civicconnect.punjab.gov.in,https://your-domain.com

# 2. Database (MongoDB Atlas recommended for production cluster)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin_user:YourSecurePassword@civic-cluster.mongodb.net/
MONGODB_DB_NAME=civic_connect_prod

# 3. Cloudinary Media Storage (For durable evidence photos & videos)
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# 4. Action Token Configuration (For one-click field officer dispatch)
ACTION_TOKEN_SECRET=generate-a-strong-secret-for-hmac-action-tokens
ACTION_TOKEN_EXPIRY_DAYS=7

# 5. Frontend Environment Variables (Vite)
# Point to your production API domain
VITE_API_URL=https://api.your-domain.com/api
# Google Gemini 2.0 Flash API Key for on-device civic image classification
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 6. Production SMS / OTP Gateway (Optional - falls back to dev log if unset)
# FAST2SMS_API_KEY=your_fast2sms_api_key
# MSG91_AUTH_KEY=your_msg91_auth_key

# =================================================================
# CIVIC CONNECT - PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# 1. Django Backend Secrets (Render)
SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
DEBUG=False
ALLOWED_HOSTS=civic-connect-o1br.onrender.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://civic-connect-psi.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://civic-connect-psi.vercel.app,https://civic-connect-o1br.onrender.com

# 2. Production Service URLs
FRONTEND_URL=https://civic-connect-psi.vercel.app
BACKEND_URL=https://civic-connect-o1br.onrender.com

# 3. Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://admin_user:YourSecurePassword@civic-cluster.mongodb.net/
MONGODB_DB_NAME=civic_connect

# 4. Cloudinary Media Storage (For durable evidence photos & videos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 5. Action Token Configuration (For one-click field officer dispatch)
ACTION_TOKEN_SECRET=generate-a-strong-secret-for-hmac-action-tokens
ACTION_TOKEN_EXPIRY_DAYS=7

# 6. Frontend Environment Variables (Vercel)
# Set these in your Vercel Project Settings > Environment Variables:
VITE_API_URL=https://civic-connect-o1br.onrender.com/api
VITE_BACKEND_URL=https://civic-connect-o1br.onrender.com
VITE_APP_URL=https://civic-connect-psi.vercel.app
VITE_GEMINI_API_KEY=your_gemini_api_key_here
